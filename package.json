{
  "name": "projeto-final-backend-geracao-tech",
  "version": "1.0.0",
  "description": "API RESTful de E-commerce desenvolvida com Node.js, Express, Sequelize, MySQL, JWT, Swagger e Jest - Projeto Final Backend Geração Tech (Digital College).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "NODE_ENV=test jest --runInBand",
    "test:coverage": "NODE_ENV=test jest --runInBand --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "mysql",
    "jwt",
    "swagger",
    "jest",
    "rest-api",
    "digital-college",
    "geracao-tech"
  ],
  "author": "Ulisses Quirino Rocha",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2",
    "sqlite3": "^6.0.1",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
